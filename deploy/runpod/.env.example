# Copia questo file in deploy/runpod/.env e inserisci i soli valori del deploy:
#   cp deploy/runpod/.env.example deploy/runpod/.env
# Questo file puo' contenere segreti ed e' ignorato da Git.
# Per usare un file diverso imposta RUNPOD_ENV_FILE=/percorso/file.

# --- Account e Pod --------------------------------------------------------
# Chiave API personale di RunPod. Creala nel pannello RunPod e non condividerla.
RUNPOD_API_KEY=''

# L'immagine CUDA e' compilata per RTX 4090 (CUDA architecture 89).
RUNPOD_GPU_ID='NVIDIA GeForce RTX 4090'
RUNPOD_POD_NAME='llm-lab-cuda-train'
RUNPOD_VOLUME_GB=40
RUNPOD_IMAGE='ghcr.io/tascaenzo/llm-lab-cuda:latest'

# --- Sessione di training -------------------------------------------------
# Circa un'ora su RTX 4090, in base alla velocita' misurata di ~5,7 step/s.
# I checkpoint ogni 5.000 step limitano a ~15 minuti la perdita massima dopo
# un'interruzione; ogni sessione terminata resta inattiva finche' non fermi il Pod.
LLM_LAB_TRAIN_STEPS=19500
LLM_LAB_CHECKPOINT_EVERY=5000
LLM_LAB_VALIDATION_EVERY=5000
LLM_LAB_VALIDATION_BATCHES=100

# Imposta 1 soltanto per il primo Pod diagnostico della nuova immagine.
LLM_LAB_PROFILE_CUDA=0

# --- Trasferimenti SSH ----------------------------------------------------
# Riempili dopo la creazione del Pod (runpodctl ssh info POD_ID).
# Esempio: RUNPOD_SSH_HOST='root@203.0.113.10'
RUNPOD_SSH_HOST=''
RUNPOD_SSH_PORT=''
# La chiave e' creata e registrata da ./deploy/runpod/setup.sh.
RUNPOD_SSH_IDENTITY_FILE="${HOME}/.runpod/ssh/runpodctl-ssh-key"
RUNPOD_REMOTE_ROOT='/workspace/llm-lab'
