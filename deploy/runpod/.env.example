# Copia questo file in deploy/runpod/.env e inserisci i soli valori del deploy:
#   cp deploy/runpod/.env.example deploy/runpod/.env
# Questo file puo' contenere segreti ed e' ignorato da Git.
# Per usare un file diverso imposta RUNPOD_ENV_FILE=/percorso/file.

# --- Account e Pod --------------------------------------------------------
# Chiave API personale di RunPod. Creala nel pannello RunPod e non condividerla.
RUNPOD_API_KEY=''

# L'immagine CUDA e' compilata per RTX 4090 (CUDA architecture 89).
RUNPOD_GPU_ID='NVIDIA GeForce RTX 4090'
RUNPOD_POD_NAME='llm-lab-cuda-train'
RUNPOD_VOLUME_GB=40
RUNPOD_IMAGE='ghcr.io/tascaenzo/llm-lab-cuda:latest'
# ID del Pod esistente; serve soltanto a ./deploy/runpod/update_pod.sh.
RUNPOD_POD_ID=''

# --- Sessione di training -------------------------------------------------
# Questa e' l'unica configurazione: gli script inoltrano soltanto le chiavi
# LLM_LAB_* elencate qui al container RunPod.
LLM_LAB_BACKEND='cuda'
# Circa un'ora su RTX 4090, in base alla velocita' misurata di ~5,7 step/s.
LLM_LAB_TRAIN_STEPS=19500
LLM_LAB_CHECKPOINT_EVERY=5000
LLM_LAB_VALIDATION_EVERY=5000
LLM_LAB_VALIDATION_BATCHES=100
# f32 e' il riferimento; tf32 e bf16-compute sono candidati da validare.
LLM_LAB_CUDA_MATH='f32'
# strict per test/parita'; step evita scansioni delle attivazioni nel training.
LLM_LAB_CUDA_NUMERICS='strict'
LLM_LAB_PROFILE_CUDA=0
# profile-only misura e poi resta inattivo; train prosegue con gli update.
LLM_LAB_RUN_MODE='train'

# Per un canary non usare lo stesso percorso in ingresso e uscita. Il baseline
# resta immutato e il candidato puo' essere eliminato senza perdere progressi.
LLM_LAB_RESUME_CHECKPOINT='artifacts/models/italiano-base-75m/latest.llmckpt'
LLM_LAB_OUTPUT_CHECKPOINT='artifacts/models/italiano-base-75m/candidate-fast.llmckpt'
LLM_LAB_BEST_CHECKPOINT='artifacts/models/italiano-base-75m/candidate-fast-best.llmckpt'
LLM_LAB_TRAINING_LOG='artifacts/models/italiano-base-75m/candidate-fast.jsonl'

# 8 x 1 conserva gli stessi 8 blocchi/update del checkpoint canonico 4 x 2.
# Zero ripristina il valore salvato nel checkpoint.
LLM_LAB_RESUME_BATCH_SIZE=0
LLM_LAB_RESUME_GRADIENT_ACCUMULATION=0

# --- Trasferimenti SSH ----------------------------------------------------
# Riempili dopo la creazione del Pod (runpodctl ssh info POD_ID).
# Esempio: RUNPOD_SSH_HOST='root@203.0.113.10'
RUNPOD_SSH_HOST=''
RUNPOD_SSH_PORT=''
# La chiave e' creata e registrata da ./deploy/runpod/setup.sh.
RUNPOD_SSH_IDENTITY_FILE="${HOME}/.runpod/ssh/runpodctl-ssh-key"
RUNPOD_REMOTE_ROOT='/workspace/llm-lab'
