# Copia questo file in .env e inserisci soltanto valori locali:
#   cp .env.example .env
# Il file .env e' ignorato da Git e non deve mai essere committato.

# --- Runtime locale -------------------------------------------------------
# Backend predefinito per train, generate, evaluate e benchmark. Sul Mac usa
# metal; su una macchina senza acceleratore usa cpu. Un eventuale --backend
# nel comando ha sempre precedenza. La pipeline RunPod forza invece cuda.
LLM_LAB_BACKEND=metal

# Facoltativo: indice GPU quando sono presenti piu' dispositivi NVIDIA.
LLM_LAB_CUDA_DEVICE=0

# --- RunPod ---------------------------------------------------------------
# Chiave API personale di RunPod. Creala nel pannello RunPod e non condividerla.
RUNPOD_API_KEY=''

# GPU prevista dalla pipeline. L'immagine CUDA e' compilata per RTX 4090
# (CUDA architecture 89); non cambiarla con una GPU incompatibile.
RUNPOD_GPU_ID='NVIDIA GeForce RTX 4090'

# Nome del Pod visibile nel pannello RunPod e spazio persistente in GiB.
RUNPOD_POD_NAME='llm-lab-cuda-train'
RUNPOD_VOLUME_GB=40

# Tag dell'immagine pubblicata dalla workflow GitHub "Build RunPod CUDA image".
RUNPOD_IMAGE='ghcr.io/tascaenzo/llm-lab-cuda:latest'

# --- Sessione di training -------------------------------------------------
# Numero di NUOVI update da eseguire in questa sessione CUDA. Il checkpoint
# viene ripreso automaticamente da artifacts/.../latest.llmckpt sul volume.
LLM_LAB_TRAIN_STEPS=1000

# Frequenze di salvataggio e validazione. Non modificano gli iperparametri
# salvati nel checkpoint, ma solo ogni quanto vengono eseguite queste azioni.
LLM_LAB_CHECKPOINT_EVERY=1000
LLM_LAB_VALIDATION_EVERY=1000
LLM_LAB_VALIDATION_BATCHES=100

# Metti 1 per la prima sessione diagnostica: prima del training il Pod misura
# le operazioni CUDA del modello e salva il report nel volume persistente.
# Il marker della versione impedisce che il profilo si ripeta ai riavvii.
LLM_LAB_PROFILE_CUDA=0

# --- Trasferimenti SSH ----------------------------------------------------
# Riempili dopo aver creato il Pod. runpodctl ssh info POD_ID mostra host e porta.
# Esempio: RUNPOD_SSH_HOST='root@203.0.113.10'
RUNPOD_SSH_HOST=''
RUNPOD_SSH_PORT=''

# Lascia il valore predefinito salvo modifiche deliberate alla pipeline.
RUNPOD_REMOTE_ROOT='/workspace/llm-lab'
