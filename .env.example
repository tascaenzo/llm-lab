# Copia questo file in .env e inserisci soltanto valori per l'esecuzione locale:
#   cp .env.example .env
# Il file .env e' ignorato da Git e non deve mai essere committato.
# Per RunPod usa invece deploy/runpod/.env.example.

# --- Runtime locale -------------------------------------------------------
# Backend predefinito per train, generate, evaluate e benchmark. Sul Mac usa
# metal; su una macchina senza acceleratore usa cpu. Un eventuale --backend
# nel comando ha sempre precedenza. La pipeline RunPod forza invece cuda.
LLM_LAB_BACKEND=metal

# Facoltativo: indice GPU quando sono presenti piu' dispositivi NVIDIA.
LLM_LAB_CUDA_DEVICE=0
